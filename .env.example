    # ================================
# SENTINEL .env.example
# Copy to .env and fill values.
# ================================

# --- Required ---
TELEGRAM_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_sealion_api_key
GEMINI_API_KEY=your_gemini_api_key

# --- SEA-LION / Translation / Guard ---
OPENAI_API_BASE=https://api.sea-lion.ai/v1
TRANSLATOR_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT
GUARD_MODEL=aisingapore/SEA-Guard
MODEL=aisingapore/Llama-SEA-LION-v3-70B-IT

# --- Gemini ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Aoede
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-2.5-flash

# --- Groq fallback (optional, recommended) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Speech (optional) ---
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# --- Research (optional) ---
FIRECRAWL_API_KEY=your_firecrawl_api_key

# --- ClickHouse logging (optional) ---
CLICKHOUSE_HOST=your_clickhouse_host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password
CLICKHOUSE_DB=agent_logs
CLICKHOUSE_CONNECT_TIMEOUT=10
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=30
CLICKHOUSE_MAX_RETRIES=1

# --- Runtime options ---
RESEARCH_DIR=research
COOLDOWN_SECONDS=3.0
